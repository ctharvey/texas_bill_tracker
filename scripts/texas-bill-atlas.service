[Unit]
Description=Publish Texas Bill Atlas from GitHub main
Wants=network-online.target
After=network-online.target
OnFailure=texas-bill-alert@%n.service

[Service]
Type=oneshot
User=texas-bill-atlas
Group=texas-bill-atlas
ExecStart=/usr/bin/python3 /usr/local/lib/texas-bill-atlas/deploy_static.py
StateDirectory=texas-bill-atlas
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/html/texas-bill-atlas
TimeoutStartSec=300
