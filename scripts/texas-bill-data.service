[Unit]
Description=Import Texas bill histories from the official bulk FTP into the live snapshot
Wants=network-online.target
After=network-online.target
OnFailure=texas-bill-alert@%n.service

[Service]
Type=oneshot
User=texas-bill-atlas
Group=texas-bill-atlas
RuntimeDirectory=texas-bill-data
UMask=0022
# The whole scripts/ folder (standard library only) from one main commit of the repository the deployer fetches, so
# moving code between files never needs this unit changed. main is resolved once so code and data match; the archive
# goes to a file first because /bin/sh has no pipefail. data/census (2020 counts for population brackets) is optional:
# build_feeds.py reads ../data/census and skips brackets without it.
ExecStartPre=/bin/sh -c 'set -e; cd "$RUNTIME_DIRECTORY"; g="/usr/bin/git --git-dir=/var/lib/texas-bill-atlas/repository.git"; c=$$($$g rev-parse --verify "main^{commit}"); paths=scripts; if $$g cat-file -e "$$c:data/census" 2>/dev/null; then paths="$$paths data/census"; fi; $$g archive --format=tar -o code.tar "$$c" $$paths; /usr/bin/tar -xf code.tar; rm code.tar; echo "code from $$c: $$paths"'
ExecStart=/bin/sh -c 'exec /usr/bin/python3 "$RUNTIME_DIRECTORY/scripts/sync_ftp.py" --out /var/www/html/texas-bill-atlas/live/bills.json --failures-file "$RUNTIME_DIRECTORY/failures"'
# Per-bill RSS feeds; files are rewritten only when a bill's actions change.
ExecStart=/bin/sh -c 'exec /usr/bin/python3 "$RUNTIME_DIRECTORY/scripts/build_feeds.py" --snapshot /var/www/html/texas-bill-atlas/live/bills.json --out /var/www/html/texas-bill-atlas/live/feeds'
# Secondary stages (history, texts, documents) and an incomplete read never block the snapshot or the feeds; they
# fail the unit here, after both, so OnFailure reports them.
ExecStart=/bin/sh -c 'if [ -s "$RUNTIME_DIRECTORY/failures" ]; then echo "Secondary stages failed:"; cat "$RUNTIME_DIRECTORY/failures"; exit 1; fi'
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/html/texas-bill-atlas/live
TimeoutStartSec=2700
