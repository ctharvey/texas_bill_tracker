[Unit]
Description=Build the agent edition (Markdown/JSON) of Texas Bill Atlas for agent.bills.ctharvey.me
Requires=docker.service
After=docker.service
OnFailure=texas-bill-alert@%n.service

[Service]
Type=oneshot
# Root only to start a short-lived, network-less node container; the build itself runs as texas-bill-atlas and
# can write only live/agent. Code is the whole scripts/ and src/ folders from one main commit of the repository the
# deployer fetches (git runs as texas-bill-atlas); archived to a file first because /bin/sh has no pipefail.
RuntimeDirectory=texas-bill-agent
RuntimeDirectoryMode=0755
ExecStartPre=/bin/sh -c 'set -e; cd "$RUNTIME_DIRECTORY"; g="/usr/sbin/runuser -u texas-bill-atlas -- /usr/bin/git --git-dir=/var/lib/texas-bill-atlas/repository.git"; c=$$($$g rev-parse --verify "main^{commit}"); $$g archive --format=tar "$$c" scripts src data/geo/districts.json > code.tar; /usr/bin/tar -xf code.tar --no-same-owner; rm code.tar; chmod -R a+rX .; echo "agent code from $$c"'
ExecStartPre=/usr/bin/install -d -m 0755 -o texas-bill-atlas -g texas-bill-atlas /var/www/html/texas-bill-atlas/live/agent
ExecStart=/bin/sh -c 'exec /usr/bin/docker run --rm --name texas-bill-agent-build --network none --read-only --cap-drop ALL --security-opt no-new-privileges --memory 512m --pids-limit 64 --user "$$(id -u texas-bill-atlas):$$(id -g texas-bill-atlas)" -v "$RUNTIME_DIRECTORY:/app:ro" -v /var/www/html/texas-bill-atlas/live:/live:ro -v /var/www/html/texas-bill-atlas/live/agent:/out node@sha256:0e1754758c2df4cfa3e68d59e2e1b7374bb7fd9ea6328eaaacf15cc934af8202 node /app/scripts/build_agent.mjs --snapshot /live/bills.json --tags /live/luna/tags.json --members /live/members.json --status /live/luna/status.json --districts /app/data/geo/districts.json --out /out'
TimeoutStartSec=600
