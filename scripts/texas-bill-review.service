[Unit]
Description=Private Texas Bill Atlas classification and review
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=texas-bill-review
Group=texas-bill-review
WorkingDirectory=/var/lib/texas-bill-review/repository
EnvironmentFile=/etc/texas-bill-review.env
Environment=TZ=America/Chicago
UMask=0077
ExecStartPre=/usr/bin/git pull --ff-only
ExecStart=/var/lib/texas-bill-review/venv/bin/python scripts/review_pipeline.py --cache-dir /var/lib/texas-bill-review/cache --no-spending-cap --transport flex --input markdown --stages --suggest-topics --audit-sample --related-bills --workers 3 --order reverse --execute --snapshot /var/www/html/texas-bill-atlas/live/bills.json --publish-tags /var/www/html/texas-bill-atlas/live/luna/tags.json
# No start timeout: killing a run mid-request strands its billing reservation and blocks later calls.
TimeoutStartSec=infinity
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/texas-bill-review /var/www/html/texas-bill-atlas/live/luna

[Install]
WantedBy=multi-user.target
